{
  "k8s-audit-retention-policy": {
    "_meta": {
      "description": "Keep audit logs hot for 7 days, warm for 30, cold until 90, then snapshot and delete after a year.",
      "iso_controls": ["A.12.4.1", "A.12.4.2", "A.16.1.7"]
    },
    "phases": {
      "hot": {
        "min_age": "0ms",
        "actions": {
          "rollover": {
            "max_primary_shard_size": "5gb",
            "max_age": "1d",
            "max_docs": 10000000
          },
          "set_priority": {
            "priority": 100
          }
        }
      },
      "warm": {
        "min_age": "7d",
        "actions": {
          "set_priority": {
            "priority": 50
          },
          "forcemerge": {
            "max_num_segments": 1
          },
          "readonly": {},
          "shrink": {
            "number_of_shards": 1
          }
        }
      },
      "cold": {
        "min_age": "30d",
        "actions": {
          "set_priority": {
            "priority": 0
          },
          "readonly": {},
          "freeze": {}
        }
      },
      "frozen": {
        "min_age": "90d",
        "actions": {
          "searchable_snapshot": {
            "snapshot_repository": "<YOUR_SNAPSHOT_REPO>",
            "force_merge_index": true
          }
        }
      },
      "delete": {
        "min_age": "366d",
        "actions": {
          "wait_for_snapshot": {
            "policy": "<YOUR_SLM_POLICY>"
          },
          "delete": {
            "delete_searchable_snapshot": false
          }
        }
      }
    }
  }
}
