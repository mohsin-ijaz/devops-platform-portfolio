# ============================================
# MULTI-PROJECT GCP CONFIGURATION
# ============================================

# Management Project (where bastion/management VM runs)
MGMT_PROJECT_ID=mgmt
MGMT_REGION=<GCP_REGION>
MGMT_ZONE=<GCP_REGION>-a

# ArgoCD Configuration (if centralized)
ARGOCD_URL=https://argocd.example.com
ARGOCD_TOKEN=<ARGOCD_TOKEN>
ARGOCD_VERIFY_SSL=true

# Schedule (MYT timezone = Asia/Kuala_Lumpur)
SCHEDULE_STOP_HOUR=20
SCHEDULE_STOP_MINUTE=0
SCHEDULE_START_HOUR=7
SCHEDULE_START_MINUTE=30

# ============================================
# ENVIRONMENT DEFINITIONS
# ============================================
# Each environment needs:
# - PROJECT_ID: Which GCP project
# - CLUSTER_NAME: GKE cluster name
# - CLUSTER_ZONE: Cluster location
# - NAMESPACE: Kubernetes namespace
# - ARGOCD_APP: ArgoCD application name (if applicable)
# - CLOUDSQL_INSTANCE: CloudSQL instance name
# - NODE_POOLS: Node pools to scale (comma-separated)
# - DESIRED_NODES: Node count per pool (comma-separated)
# ============================================

# QA-DEV1 Environment
QA_DEV1_PROJECT_ID=<GCP_QA_PROJECT_ID>
QA_DEV1_CLUSTER_NAME=qa-cluster-1
QA_DEV1_CLUSTER_ZONE=<GCP_REGION>-a
QA_DEV1_NAMESPACE=qa-dev1
QA_DEV1_ARGOCD_APP=qa-dev1-app
QA_DEV1_CLOUDSQL_INSTANCE=qa-dev1-db
QA_DEV1_NODE_POOLS=qa-dev1-pool
QA_DEV1_DESIRED_NODES=3

# QA-DEV2 Environment
QA_DEV2_PROJECT_ID=<GCP_QA_PROJECT_ID>
QA_DEV2_CLUSTER_NAME=qa-cluster-1
QA_DEV2_CLUSTER_ZONE=<GCP_REGION>-a
QA_DEV2_NAMESPACE=qa-dev2
QA_DEV2_ARGOCD_APP=qa-dev2-app
QA_DEV2_CLOUDSQL_INSTANCE=qa-dev2-db
QA_DEV2_NODE_POOLS=qa-dev2-pool
QA_DEV2_DESIRED_NODES=3

# QA-DEV3 Environment
QA_DEV3_PROJECT_ID=<GCP_QA_PROJECT_ID>
QA_DEV3_CLUSTER_NAME=qa-cluster-1
QA_DEV3_CLUSTER_ZONE=<GCP_REGION>-a
QA_DEV3_NAMESPACE=qa-dev3
QA_DEV3_ARGOCD_APP=qa-dev3-app
QA_DEV3_CLOUDSQL_INSTANCE=qa-dev3-db
QA_DEV3_NODE_POOLS=qa-dev3-pool
QA_DEV3_DESIRED_NODES=3

# LGTM Environment
LGTM_PROJECT_ID=<GCP_MGMT_PROJECT_ID>
LGTM_CLUSTER_NAME=mgmt-cluster-1
LGTM_CLUSTER_ZONE=<GCP_REGION>-a
LGTM_NAMESPACE=lgtm
LGTM_ARGOCD_APP=lgtm-app
LGTM_CLOUDSQL_INSTANCE=lgtm-db
LGTM_NODE_POOLS=lgtm-pool
LGTM_DESIRED_NODES=2

# ============================================
# ACTIVE ENVIRONMENTS
# Comma-separated list of environments to manage
# ============================================
ENVIRONMENTS=qa-dev1,qa-dev2,qa-dev3,lgtm

# ============================================
# PROJECTS REQUIRING ACCESS
# Used for service account permissions setup
# ============================================
TARGET_PROJECTS=<GCP_QA_PROJECT_ID>,<GCP_MGMT_PROJECT_ID>
