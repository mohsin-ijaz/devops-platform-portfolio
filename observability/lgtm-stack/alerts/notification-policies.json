{
  "receiver": "grafana-default-email",
  "group_by": [
    "grafana_folder",
    "alertname"
  ],
  "routes": [
    {
      "receiver": "grafana-default-email",
      "object_matchers": [
        [
          "alertname",
          "=",
          "DatasourceError"
        ]
      ]
    },
    {
      "receiver": "PagerDuty Critical",
      "object_matchers": [
        [
          "severity",
          "=",
          "critical"
        ]
      ]
    },
    {
      "receiver": "PagerDuty Warning",
      "object_matchers": [
        [
          "severity",
          "=",
          "warning"
        ]
      ]
    }
  ]
}
